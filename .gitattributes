# Store text files with LF in the repo; check out with each platform's native
# endings. Keeps Windows and Linux contributors from producing whole-file diffs.
* text=auto

# Node tooling stays LF on disk everywhere — it's run directly, not edited much.
*.mjs text eol=lf

# Gradle wrapper must stay executable on Unix CI checkouts.
Android/gradlew text eol=lf
