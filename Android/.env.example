# Atlas instance this build talks to for ride sharing (optional feature).
# Copy to .env.dev.local and edit. .env.dev.local is gitignored.
#
# The client fetches OAuth and upload endpoints from:
#   {SCOUT_INSTANCE_URL}/.well-known/scout-upload.json
# See ../docs/SHARING.md

SCOUT_INSTANCE_URL=https://example.com
SCOUT_INSTANCE_NAME=Your Atlas
