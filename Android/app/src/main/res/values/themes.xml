<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cold start opens on the page colour instead of flashing the opposite one.
         This can only follow the system; MainActivity repaints it when the rider has
         overridden the appearance. -->
    <style name="Theme.Scout" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- 288×288 dp splash icon; SVG artboard is 288, rasterised at 4× for sharpness. -->
    <style name="Theme.Scout.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Scout</item>
        <item name="android:windowBackground">@color/brand</item>
    </style>
</resources>
